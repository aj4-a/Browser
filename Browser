function checkExtensionURL(u){
    return fetch(u).then(function(r){return r.ok}).catch(function(){
        return fetch(u,{method:'HEAD'}).then(function(r){return r.ok}).catch(function(){return false});
    });
}
function getExtensionId(u){var m=u.match(/^chrome-extension:\/\/([^\/]+)/);return m?m[1]:'Unknown';}
function tryAddExtension(n,i,u){
    var s=document.getElementById('show-all-extensions').checked;
    function add(){
        var d=document.createElement('div');d.className='extension-container';
        var dot=document.createElement('span');dot.className='extension-status';d.appendChild(dot);
        var info=document.createElement('div');info.className='extension-info';
        var img=document.createElement('img');img.src=i||defaultIcon;
        info.appendChild(img);
        var nm=document.createElement('span');nm.className='extension-name';nm.textContent=n;info.appendChild(nm);
        var id=document.createElement('span');id.className='extension-id';id.textContent='ID: '+getExtensionId(u);
        var btn=document.createElement('button');btn.textContent='Disable';
        btn.onclick=function(){createPopup(n,img.src,u,getExtensionId(u))};
        d.appendChild(btn);d.appendChild(id);d.appendChild(info);
        document.getElementById('div-container').appendChild(d);return true;
    }
    if(s)return Promise.resolve(add());
    return checkExtensionURL(u).then(function(ok){if(ok)return add();return false});
}
function loadExtensions(){
    var c=document.getElementById('div-container');c.innerHTML='';
    var found=false;
    var keys=Object.keys(extensions);
    function processNext(idx){
        if(idx>=keys.length){
            document.getElementById('no-extensions').style.display=found?'none':'block';
            if(found)document.getElementById('kill-counter').style.display='inline-block';
            return;
        }
        tryAddExtension(keys[idx],'',extensions[keys[idx]]).then(function(r){if(r)found=true;processNext(idx+1)});
    }
    processNext(0);
}

