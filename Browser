function joinRoom(){var u=document.getElementById('msg-username').value.trim()||'Anon',r=document.getElementById('msg-room').value.trim();if(!r)return alert('Enter room code');mpId='p_'+Math.random().toString(36).slice(2,10);document.getElementById('msg-my-id').textContent=mpId;document.getElementById('msg-join-btn').style.display='none';document.getElementById('msg-leave-btn').style.display='inline-block';document.getElementById('msg-minimize-btn').style.display='inline-block';document.getElementById('msg-input').disabled=false;document.getElementById('msg-send-btn').disabled=false;document.getElementById('msg-chat-area').innerHTML='';document.getElementById('msg-mini-chat').innerHTML='';document.getElementById('msg-mini-room').textContent=r;am('🔗 Joined: <b>'+r+'</b>');amm('🔗 Joined: <b>'+r+'</b>');mpPeer=new SimplePeer({initiator:true,trickle:false});sp(mpPeer);try{var bc=new BroadcastChannel('msg_'+r);bc.onmessage=function(e){if(e.data.from===mpId)return;if(e.data.type==='signal'){var p=new SimplePeer({initiator:false,trickle:false});sp(p);p.signal(e.data.signal);p.on('signal',d=>bc.postMessage({from:mpId,type:'signal',signal:d}))}};mpPeer.on('signal',d=>bc.postMessage({from:mpId,type:'signal',signal:d}))}catch(e){am('⚠️ Same-device only')}}
