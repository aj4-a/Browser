    if(!url)return alert('Enter a URL');
    if(!url.startsWith('http'))url='https://'+url;
    var title=document.getElementById('mask3r-title').value.trim()||'My Page';
    var favInput=document.getElementById('mask3r-favicon');
    var preset=mask3rPresets[document.getElementById('mask3r-preset').value];
