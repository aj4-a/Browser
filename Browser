var pwData=[],pwKey=null;
async function pwDeriveKey(pw){var enc=new TextEncoder(),km=await crypto.subtle.importKey('raw',enc.encode(pw),'PBKDF2',false,['deriveKey']);return crypto.subtle.deriveKey({name:'PBKDF2',salt:enc.encode('extprint3r'),iterations:100000,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,['encrypt','decrypt'])}
async function pwEncrypt(key,data){var iv=crypto.getRandomValues(new Uint8Array(12)),enc=await crypto.subtle.encrypt({name:'AES-GCM',iv},key,new TextEncoder().encode(data));return{iv:Array.from(iv),data:Array.from(new Uint8Array(enc))}}
async function pwDecrypt(key,iv,data){try{var dec=await crypto.subtle.decrypt({name:'AES-GCM',iv:new Uint8Array(iv)},key,new Uint8Array(data));return new TextDecoder().decode(dec)}catch(e){return null}}
async function pwCreate(){var pw=document.getElementById('pwvault-master').value;if(!pw||pw.length<4)return alert('Password must be 4+ chars');if(localStorage.getItem('pwvault_data'))return alert('Vault exists — unlock it');pwKey=await pwDeriveKey(pw);pwData=[];await pwSave();document.getElementById('pwvault-locked').style.display='none';document.getElementById('pwvault-unlocked').style.display='block';pwRender()}
async function pwUnlock(){var pw=document.getElementById('pwvault-master').value;if(!pw)return alert('Enter password');var raw=localStorage.getItem('pwvault_data');if(!raw)return alert('No vault found');try{var stored=JSON.parse(raw);pwKey=await pwDeriveKey(pw);var test=await pwDecrypt(pwKey,stored.iv,stored.data);if(!test)return alert('Wrong password!');pwData=JSON.parse(test);document.getElementById('pwvault-locked').style.display='none';document.getElementById('pwvault-unlocked').style.display='block';pwRender()}catch(e){alert('Wrong password')}}
function pwLock(){pwKey=null;document.getElementById('pwvault-locked').style.display='block';document.getElementById('pwvault-unlocked').style.display='none';document.getElementById('pwvault-master').value=''}
