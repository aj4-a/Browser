        var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=title.replace(/\s+/g,'_')+'.html';a.click();
    }
    if(favInput.files.length>0){
        var reader=new FileReader();reader.onloadend=function(){buildAndDownload(reader.result)};reader.readAsDataURL(favInput.files[0]);
