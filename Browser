    navigator.serviceWorker.register(url,{scope:'/'}).then(function(){document.getElementById('sw-status').innerHTML='<span style="color:#4caf50;">● Active</span>';document.getElementById('sw-register-btn').disabled=true;URL.revokeObjectURL(url)}).catch(function(e){alert('Failed: '+e.message)})
}
