        *{margin:0;padding:0;box-sizing:border-box;font-family:"Roboto",sans-serif}
        body{background-color:#1e1f22;color:#fff;display:flex;margin-left:250px;min-height:100vh}
        .side-panel{position:fixed;top:0;left:0;width:250px;height:100vh;background-color:#292a2d;color:#fff;display:flex;flex-direction:column;padding:20px;border-right:1px solid #444;z-index:100}
        .side-panel h2{font-size:1.3em;font-weight:600;user-select:none;margin-bottom:30px}
        .side-panel .nav-section{margin-bottom:20px}
        .side-panel .nav-label{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#8e918f;margin-bottom:8px;padding-left:12px;user-select:none}
        .side-panel .option{position:relative;overflow:hidden;margin:4px 0;font-size:15px;cursor:pointer;user-select:none;border-radius:8px;height:42px;display:flex;align-items:center;padding:0 16px;color:#c4c7c5;transition:all .15s ease}
        .side-panel .option:hover{background-color:#38393b;color:#fff}
        .side-panel .option.selected{background-color:#8ab4f8;color:#1e1f22;font-weight:600}
        .side-panel .option .icon{margin-right:10px;font-size:18px}
        .side-panel footer{margin-top:auto;text-align:center;padding:15px 0;font-size:13px;color:#6b6e6d;border-top:1px solid #38393b}
        .side-panel footer a{color:#9dbae9;text-decoration:none}
        .side-panel footer a:hover{text-decoration:underline}
        .main-content{flex-grow:1;padding:30px}
        .tab-content{display:none}
        .tab-content.active{display:block}
        h2{font-size:1.6em;font-weight:400;margin-bottom:20px}
        h3{font-size:1.1em;font-weight:400;color:#c4c7c5;margin-bottom:15px}
        #div-container{display:flex;flex-wrap:wrap;gap:12px}
        .extension-container{display:flex;flex-direction:column;justify-content:space-between;padding:16px;border-radius:12px;width:340px;height:150px;background:#292a2d;border:1px solid #38393b;transition:border-color .2s;position:relative}
        .extension-container:hover{border-color:#8ab4f8}
        .extension-info{display:flex;align-items:center;gap:10px}
        .extension-info img{width:36px;height:36px;border-radius:8px;background:#38393b}
        .extension-name{font-size:14px;font-weight:500}
        .extension-id{font-size:11px;color:#6b6e6d}
        .extension-container button{background:0 0;color:#8ab4f8;font-weight:600;border:1px solid #8ab4f8;border-radius:20px;padding:8px 20px;cursor:pointer;align-self:flex-end;transition:all .2s;font-size:13px}
        .extension-container button:hover{background:#8ab4f8;color:#1e1f22}
        .extension-status{position:absolute;top:12px;right:12px;width:8px;height:8px;border-radius:50%;background:#4caf50}
        .url-bar{display:flex;gap:10px;margin-bottom:16px}
        .url-bar input{flex:1;padding:12px 16px;border:1px solid #38393b;border-radius:25px;background:#292a2d;color:#fff;font-size:14px;outline:0;transition:border-color .2s}
        .url-bar input:focus{border-color:#8ab4f8}
        .url-bar button, .settings-group button{background:#8ab4f8;color:#1e1f22;border:none;border-radius:8px;padding:10px 20px;font-weight:600;cursor:pointer;transition:all .2s}
        .url-bar button:hover, .settings-group button:hover{background:#6a94d8}
        .settings-group{margin-bottom:24px;padding:20px;background:#292a2d;border-radius:12px;border:1px solid #38393b}
        .settings-group label{display:block;margin-bottom:10px;font-size:14px;color:#c4c7c5}
        .settings-group input[type=range]{width:100%;margin:8px 0;accent-color:#8ab4f8}
        .settings-group input[type=text], .settings-group input[type=url], .settings-group select{width:100%;padding:10px;background:#1e1f22;color:#fff;border:1px solid #38393b;border-radius:8px;font-size:14px;margin-bottom:10px}
        .settings-group input[type=file]{margin-bottom:10px;color:#c4c7c5}
        input[type=checkbox]{accent-color:#8ab4f8;width:18px;height:18px;margin-right:8px}
        .kill-badge{display:inline-block;background:#f44336;color:#fff;border-radius:12px;padding:2px 10px;font-size:12px;font-weight:600;margin-left:8px}
        .modal-overlay{position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,.7);z-index:999;display:flex;justify-content:center;align-items:center}
        .modal{background:#292a2d;color:#fff;width:520px;border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5)}
        .modal-header{display:flex;align-items:center;justify-content:space-between;background:#1e1f22;padding:16px 20px;border-bottom:1px solid #444}
        .modal-header .close-btn{cursor:pointer;font-size:24px;color:#9aa0a6;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background .2s}
        .modal-header .close-btn:hover{background:rgba(255,255,255,.1)}
        .modal-body{padding:20px;line-height:1.6}
        .modal-body .url-highlight{display:block;background:#1e1f22;padding:8px 12px;border-radius:6px;margin:8px 0;font-family:monospace;color:#8ab4f8;word-break:break-all}
        .modal-footer{display:flex;justify-content:center;padding:16px 20px}
        .modal-footer button{background:#8ab4f8;color:#1e1f22;border:none;border-radius:25px;padding:12px 40px;font-weight:600;font-size:15px;cursor:pointer;transition:all .2s}
        .modal-footer button:hover{background:#6a94d8;transform:scale(1.03)}
        .footer-note{font-size:0.9rem;text-align:center;color:#aaa;margin-top:15px}
        .footer-note a{color:#8ab4f8;text-decoration:none}
    </style>
</head>
